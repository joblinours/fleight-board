# Configuration du déploiement (docker-compose.yml) : copier en `.env`,
# ou saisir ces variables dans Portainer (« Environment variables » de la stack).

# --- Obligatoire ----------------------------------------------------------------
# Mot de passe de PostgreSQL : lettres et chiffres uniquement (il entre dans une URL).
# Générer : openssl rand -hex 24
POSTGRES_PASSWORD=

# Premier Admin, créé au premier démarrage s'il n'existe aucun Admin actif
# (mot de passe : 10 caractères minimum, à changer ensuite depuis l'interface).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Réseau ---------------------------------------------------------------------
# Port publié sur l'hôte : http://<serveur>:8080
FLEIGHT_PORT=8080
# Derrière un reverse proxy HTTPS (Traefik, Caddy, Nginx Proxy Manager…) : true
TRUST_PROXY=false

# --- Application ----------------------------------------------------------------
# Demandes de création de compte depuis la page de connexion
ALLOW_REGISTRATION=true
# Taille maximale d'une image importée (Mio)
MAX_UPLOAD_MB=10
# Durée de vie des sessions : maximale et après inactivité (jours)
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
# Logs JSON : fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# --- Avancé ---------------------------------------------------------------------
# Image à déployer (une version précise : ghcr.io/joblinours/fleight-board:v0.1.0)
# FLEIGHT_IMAGE=ghcr.io/joblinours/fleight-board:latest
# POSTGRES_USER=fleight
# POSTGRES_DB=fleight
