# Adresse d'écoute de l'API
HOST=0.0.0.0
PORT=3000
# Niveau de logs : fatal, error, warn, info, debug, trace
LOG_LEVEL=info
# Base PostgreSQL (voir infrastructure/compose/docker-compose.dev.yml).
# Si POSTGRES_PORT a été changé pour `pnpm db:up`, reporter le port ici.
DATABASE_URL=postgres://fleight:fleight@localhost:5432/fleight

# Premier Admin, créé au démarrage s'il n'existe aucun Admin actif
# (mot de passe : 10 caractères minimum). ./scripts/dev.sh les génère.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=
# Demandes de création de compte depuis l'interface (true / false)
ALLOW_REGISTRATION=true
# Durée de vie des sessions : maximale et après inactivité (jours)
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
# Derrière un reverse proxy HTTPS : lire le protocole et l'IP dans X-Forwarded-*
TRUST_PROXY=false
